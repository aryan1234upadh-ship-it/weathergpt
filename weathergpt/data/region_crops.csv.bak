North,Uttar Pradesh,Maize,18,32,50,5.5,7.5,Irrigate at knee-high and tasseling,Ensure good drainageconst fs = require("fs");
const {
  Document, Packer, Paragraph, TextRun, HeadingLevel, AlignmentType, LevelFormat, PageOrientation,
  Table, TableRow, TableCell, WidthType, BorderStyle, ShadingType, Footer, PageNumber
} = require("docx");

const FONT = { ascii: "Nirmala UI", hAnsi: "Nirmala UI", cs: "Nirmala UI", eastAsia: "Nirmala UI" };
const GREEN = "1F5D3A", GREY = "5B6B62", AMBER = "FFF4D6", LIGHT = "E4EDE6";
const PAGE_W = 16838, MARGIN = 1000, CONTENT = PAGE_W - 2 * MARGIN;   // landscape A4

const run = (text, o = {}) => new TextRun({ text, font: FONT, size: 20, ...o, boldComplexScript: !!o.bold });
const b = (text, o = {}) => run(text, { bold: true, ...o });
const para = (runs, o = {}) => new Paragraph({ spacing: { after: 100, line: 276 }, ...o, children: [].concat(runs) });
const p = (text) => para(run(text));
const h1 = (text) => new Paragraph({ heading: HeadingLevel.HEADING_1, spacing: { before: 300, after: 120 }, keepNext: true,
  children: [new TextRun({ text, font: FONT, bold: true, boldComplexScript: true })] });
const h2 = (text) => new Paragraph({ heading: HeadingLevel.HEADING_2, spacing: { before: 200, after: 80 }, keepNext: true,
  children: [new TextRun({ text, font: FONT, bold: true, boldComplexScript: true })] });
const bullet = (runs) => new Paragraph({ numbering: { reference: "bullets", level: 0 }, spacing: { after: 70, line: 270 }, children: [].concat(runs) });
const bl = (text) => bullet(run(text));

const line = { style: BorderStyle.SINGLE, size: 4, color: "D8E1DA" };
const borders = { top: line, bottom: line, left: line, right: line };

function cell(width, content, fill, boldText) {
  const items = [].concat(content);
  return new TableCell({
    width: { size: width, type: WidthType.DXA }, borders,
    margins: { top: 60, bottom: 60, left: 100, right: 100 },
    shading: fill ? { fill, type: ShadingType.CLEAR, color: "auto" } : undefined,
    children: items.map(t => new Paragraph({ spacing: { after: 30, line: 250 },
      children: [run(String(t), { size: 17, bold: !!boldText })] }))
  });
}
function table(headers, widths, rows) {
  const total = widths.reduce((a, c) => a + c, 0);
  if (total !== CONTENT) throw new Error("widths sum " + total + " != " + CONTENT + " for " + headers[0]);
  return new Table({
    width: { size: total, type: WidthType.DXA }, columnWidths: widths,
    rows: [
      new TableRow({ tableHeader: true, cantSplit: true, children: headers.map((h, i) => cell(widths[i], h, LIGHT, true)) }),
      ...rows.map(r => new TableRow({ cantSplit: true, children: r.map((c, i) => cell(widths[i], c)) }))
    ]
  });
}
const gap = () => new Paragraph({ spacing: { after: 60 }, children: [] });
const note = (text) => new Paragraph({ spacing: { before: 60, after: 120 }, shading: { fill: AMBER, type: ShadingType.CLEAR, color: "auto" },
  border: { left: { style: BorderStyle.SINGLE, size: 18, color: "E8A317", space: 6 } }, children: [run(text, { size: 19 })] });

const W5 = [2300, 1500, 4200, 2300, 4538];        // Parameter | Unit | Source | Level | DB field/format
const H5 = ["Parameter", "Unit", "Reliable source", "Geographic level", "DB field / format"];

const kids = [];
const add = (...x) => kids.push(...x);

/* ---------- Title ---------- */
add(new Paragraph({ spacing: { after: 40 }, children: [new TextRun({ text: "Agriculture Data Collection Guide", font: FONT, size: 48, bold: true, boldComplexScript: true, color: GREEN })] }));
add(new Paragraph({ spacing: { after: 200 }, border: { bottom: { style: BorderStyle.SINGLE, size: 8, color: GREEN, space: 6 } },
  children: [run("Team research checklist, source list and database design  |  WeatherGPT (SIH)  |  20 September 2026", { color: GREY })] }));

/* ---------- 0. Summary ---------- */
add(h1("0. सबसे पहले: सीधा जवाब"));
add(para([b("सवाल 1: क्या team को data research करके collect करना होगा?  "), run("हाँ। Authentic और region-specific data का सही तरीका यही है कि team official sources (SHC portal, ICAR/SAU, IMD, DES, CGWB आदि) से data निकाले, उसे verify करे और source के साथ database में डाले।")]));
add(para([b("सवाल 2: क्या Claude पूरा database बना कर दे सकता है?  "), run("नहीं, और यह suggest भी नहीं किया जाता। अगर मैं memory से soil, crop या region के numbers लिखूँ तो वही AI-assumption होगा जिससे आप बचना चाहते हैं: वह गलत, पुराना या किसी दूसरे region का हो सकता है।")]));
add(para(b("Claude क्या कर सकता है:")));
add(bl("Schema और checklist (यह document) और CSV/Excel templates।"));
add(bl("Import और validation code: unit check, range check (जैसे pH 3 से 10), duplicate और missing-value check।"));
add(bl("आपकी team का collected data साफ करके database में डालना, और उसे web app से जोड़ना।"));
add(bl("App का rules engine, जो सिर्फ database के sourced data पर चले और जहाँ data नहीं है वहाँ साफ लिखे \"data उपलब्ध नहीं\"।"));
add(h2("Data collection के 7 नियम"));
add(bl("हर row के साथ source: संस्था, dataset का नाम, URL, data का साल, कब access किया (section 13)।"));
add(bl("कोई value अंदाज़े से नहीं। जो नहीं मिला उसे खाली (NULL) छोड़ो। जो गणना से निकाला उसे status = derived या estimated लिखो।"));
add(bl("Units fix रखो (हर table में unit column या parameter table में unit)।"));
add(bl("District/block की पहचान के लिए LGD code इस्तेमाल करो, सिर्फ नाम नहीं (नाम की spelling अलग-अलग होती है)।"));
add(bl("Data का साल (data_year) हमेशा लिखो। पुराना data भी चलेगा, पर साल दिखना चाहिए।"));
add(bl("Random websites से नहीं। सिर्फ official/credible sources (section 11)। जो source मैंने खुद जाँचा वह \"Checked\" लिखा है, बाकी को team verify करेगी।"));
add(bl("पहले pilot: कम states और कम crops में पूरा और verified data, फिर बढ़ाओ। सुझाव: 3 states (जैसे Bihar, Punjab, Maharashtra) × 5 major crops।"));
add(note("इस हफ़्ते का deadline देखते हुए: 600 अंदाज़े वाली rows से 60 verified rows बेहतर हैं। Judges source और reliability देखते हैं।"));

