  ["Directorate of Economics and Statistics (MoA&FW)", "Agricultural Statistics: area, production, yield, land use", "District, साल-वार", "सालाना", "Official publication। data.gov.in पर भी", "Team verify"],
  ["LGD (Local Government Directory)", "lgdirectory.gov.in: state/district/block/village codes", "Village तक", "समय-समय पर", "Official codes", "Team verify"],
  ["CGWB (Central Ground Water Board)", "cgwb.gov.in: groundwater levels, resource assessment", "Block / district", "सालाना", "Official reports", "Team verify"],
