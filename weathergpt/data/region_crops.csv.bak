/* ---------- 15. Schema ---------- */
add(h1("15. Database schema (practical)"));
add(table(["Table", "Important columns"], [3400, 11438], [
  ["sources", "id, organization, title, url, licence_note, data_year, date_accessed"],
  ["regions", "id, level (state/district/block), lgd_code, name, name_hi, parent_id, lat, lon, area_ha, agro_zone_id, aer_id, boundary_file, source_id"],
  ["agro_zones", "id, name, type (NARP / AER), state, description"],
  ["soil_types", "id, name, taxonomy_order, texture_class, sand_pct, silt_pct, clay_pct, drainage_class, whc, whc_method, source_id"],
  ["region_soil", "region_id, soil_type_id, area_pct, source_id"],
  ["soil_parameters", "id, code, name, unit, min_valid, max_valid, low_cut, high_cut, source_id"],
  ["soil_measurements", "id, region_id, parameter_id, value, rating, pct_low, pct_medium, pct_high, sample_count, data_year, status, confidence, source_id"],
  ["crops", "id, name_en, name_hi, scientific_name, category, source_id"],
  ["crop_requirements", "id, crop_id, agro_zone_id or state, season, duration_days, ph_min, ph_max, temp_min, temp_opt_min, temp_opt_max, temp_max, rain_min, rain_max, water_req_mm, salinity_tolerance, drainage_pref, texture_pref, sowing_start, sowing_end, harvest_start, harvest_end, source_id"],
  ["crop_stages", "id, crop_id, stage_name, day_from, day_to, kc, water_need, critical_irrigation, heat_stress_above, cold_stress_below, harmful_rain_24h, wind_risk, source_id"],
  ["region_crops", "region_id, crop_id, season, area_ha, production_t, yield_q_ha, data_year, source_id"],
  ["soil_crop_compatibility", "soil_type_id, crop_id, suitability_class, notes, source_id"],
  ["weather_normals", "region_id, month, temp_max_avg, temp_min_avg, rainfall_mm, rainy_days, humidity, period, source_id"],
  ["weather_rules", "id, event_type, parameter, threshold, unit, source_id (IMD definitions)"],
  ["weather_cache (मौजूद है)", "district, data_json, cached_at (live data)"],
  ["irrigation_region", "region_id, source_type (canal/tube-well/tank/river/rainfed), area_ha, pct, year, source_id"],
  ["groundwater", "region_id, year, stage_pct, category, water_level_m, source_id"],
  ["irrigation_practice", "crop_id, agro_zone_id, num_irrigations, critical_stages, method_suitability, source_id"],
  ["fertilizers", "id, name, n_pct, p2o5_pct, k2o_pct, type, source_id"],
  ["fertilizer_recommendations", "crop_id, state/zone, soil_rating, n_kg_ha, p2o5_kg_ha, k2o_kg_ha, micronutrient_note, timing_notes, source_id"],
  ["pests_diseases", "id, name, scientific_name, type, symptoms, favourable_conditions, etl, management, source_id"],
  ["crop_pest", "crop_id, pest_id, stage, season, region_id"],
  ["farmer_soil_tests (private)", "farmer_id, test_date, parameter_id, value, unit, lab_note"]
]));
add(p("आपके मौजूदा app के tables इनसे ऐसे जुड़ेंगे: RegionCrop → crop_requirements और region_crops, SoilHealth → soil_measurements, WeatherCache वैसा ही रहेगा। जब team का CSV data आएगा तो import और validation scripts बनेंगी।"));

/* ---------- 16. Team ---------- */
add(h1("16. Team work division"));
add(p("6 members के लिए सुझाव: category के हिसाब से बाँटो (हर कोई एक जैसा template भरे), और हर member उन्हीं 3 pilot states के लिए data निकाले। इससे region-wise data आपस में मेल खाता है।"));
add(table(["Member", "Category", "Tables जो भरेंगे", "मुख्य sources"], [1600, 4200, 4600, 4438], [
  ["1", "Soil और Soil Health Card", "soil_types, region_soil, soil_parameters, soil_measurements", "SHC portal, ICAR-NBSS&LUP, state soil labs"],
  ["2", "Crops और crop requirements", "crops, crop_requirements, crop_stages, region_crops", "SAU package of practices, ICAR, DES"],
  ["3", "Weather और climate", "weather_normals, weather_rules, live API mapping", "IMD, Open-Meteo, NASA POWER"],
  ["4", "Water, irrigation और fertilizer", "irrigation_region, groundwater, irrigation_practice, fertilizers, fertilizer_recommendations", "CGWB, India-WRIS, MI Census, SAU"],
  ["5", "Regions और GIS", "regions, agro_zones, boundary files (नाम DB से match)", "LGD, official boundary files, ICAR zones"],
  ["6", "Sources, pests और validation lead", "sources, pests_diseases, crop_pest, और सबका QA", "NCIPM, CIB&RC, सभी sources की licence जाँच"]
]));
add(h2("बेहतर संयोजन"));
add(bl("पहले 6 घंटे में सब मिलकर pilot states, crops और sources तय करें (member 6 source register बनाए)।"));
add(bl("हर member Excel/CSV में एक ही column template इस्तेमाल करे (section 17)। साझा folder में एक file per member।"));
add(bl("Member 6 हर file की 10% rows source से दोबारा मिलाए, फिर file import के लिए तैयार मानी जाए।"));
add(bl("Deadline क्रम: (1) sources और pilot scope, (2) raw data collection, (3) cleaning और validation, (4) database import और demo।"));

/* ---------- 17. Template + team message ---------- */
add(h1("17. Collection template और team के लिए final checklist"));
add(p("हर member की file में ये columns हों (नीचे 4 provenance columns हर row में जरूरी):"));
add(p("region_lgd_code | region_name | parameter / field | value | unit | data_year | source_name | source_url | page_or_table_ref | date_accessed | licence_note | status | collected_by | verified_by | notes"));
add(table(["सदस्य", "क्या research करना है", "कौन से fields", "Source कहाँ से", "किस format में दें", "Database में कहाँ जाएगा"], [1200, 3200, 3800, 2900, 2200, 1538], [
  ["1 Soil", "3 pilot states के हर district की soil और nutrient status", "soil type, texture, drainage, pH, EC, OC, N, P, K, Zn, S", "SHC portal dashboard, ICAR-NBSS&LUP", "CSV, section 17 template", "soil_*"],
  ["2 Crops", "5 major crops की requirements और calendar", "pH range, temperature, water, season, sowing/harvest, area/yield", "SAU PoP, ICAR, DES", "CSV, section 17 template", "crop_*"],
  ["3 Climate", "Normals और extreme-event definitions", "monthly rainfall/temp normals, IMD thresholds", "IMD, NASA POWER, Open-Meteo", "CSV", "weather_*"],
  ["4 Water", "Irrigation, groundwater, fertilizer doses", "sources, stage_pct, category, N-P2O5-K2O doses", "CGWB, MI Census, SAU", "CSV", "irrigation_*, fertilizer_*"],
  ["5 Regions", "Codes, boundaries, zones", "LGD codes, lat/lon, zone, boundary file name", "LGD, official boundaries, ICAR zones", "CSV + GeoJSON", "regions, agro_zones"],
  ["6 QA", "Sources register, pests, validation", "source details, pest fields, verification log", "NCIPM, CIB&RC, सभी sources", "CSV + checklist", "sources, pests_*"]
]));
add(h2("WhatsApp पर भेजने का संदेश"));
add(p("Team, हमें AI के अंदाज़े नहीं, official data से database बनाना है। हर member अपनी category का data इस document के section 17 वाले template में भरे: value + unit + साल + source name + source URL + page/table + तारीख। जो नहीं मिला वह खाली छोड़ो, अंदाज़ा मत लिखो। पहले 3 states (Bihar, Punjab, Maharashtra) और 5 major crops पर काम करेंगे। हर file Member 6 verify करेगा (10% rows source से मिलाकर), फिर import होगी।"));

const doc = new Document({
  creator: "Claude", title: "Agriculture Data Collection Guide",
  styles: {
    default: { document: { run: { font: FONT, size: 20 } } },
    paragraphStyles: [
      { id: "Heading1", name: "Heading 1", basedOn: "Normal", next: "Normal", quickFormat: true,
        run: { size: 30, bold: true, font: FONT, color: GREEN }, paragraph: { spacing: { before: 300, after: 120 }, outlineLevel: 0 } },
      { id: "Heading2", name: "Heading 2", basedOn: "Normal", next: "Normal", quickFormat: true,
        run: { size: 24, bold: true, font: FONT, color: GREEN }, paragraph: { spacing: { before: 200, after: 80 }, outlineLevel: 1 } }
    ]
  },
  numbering: { config: [{ reference: "bullets", levels: [{ level: 0, format: LevelFormat.BULLET, text: "\u2022", alignment: AlignmentType.LEFT,
    style: { paragraph: { indent: { left: 540, hanging: 270 } } } }] }] },
  sections: [{
    properties: { page: { size: { width: 11906, height: 16838, orientation: PageOrientation.LANDSCAPE }, margin: { top: 1000, right: MARGIN, bottom: 1000, left: MARGIN } } },
    footers: { default: new Footer({ children: [new Paragraph({ alignment: AlignmentType.CENTER, children: [
      new TextRun({ text: "Agriculture Data Collection Guide  |  Page ", font: FONT, size: 16, color: GREY }),
      new TextRun({ children: [PageNumber.CURRENT], font: FONT, size: 16, color: GREY })] })] }) },
    children: kids
  }]
});

Packer.toBuffer(doc).then(buf => {
  fs.mkdirSync("/mnt/user-data/outputs", { recursive: true });
  fs.writeFileSync("/mnt/user-data/outputs/Agriculture-Data-Collection-Guide.docx", buf);
  console.log("written", buf.length, "bytes");
});